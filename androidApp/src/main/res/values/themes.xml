<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- System splash (Android 12+ SplashScreen API falls back to this) -->
    <style name="Theme.PicoChat" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pico_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- See-through window for the assistant card -->
    <style name="Theme.PicoChat.Assist" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
